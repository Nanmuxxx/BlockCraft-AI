{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockcraft:trusted-interactive:1",
  "title": "Trusted interactive generation / 1 (AppSpec v2 subset)",
  "type": "object", "additionalProperties": false,
  "required": ["version", "id", "name", "entities", "blocks", "relations"],
  "properties": {
    "version": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "entities": { "type": "array", "maxItems": 0 },
    "relations": { "type": "array", "maxItems": 0 },
    "blocks": { "type": "array", "minItems": 1, "maxItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "type", "protocolVersion", "durationSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
        "type": { "const": "pomodoro" }, "protocolVersion": { "const": 1 },
        "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 }
      }
    } }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$", "not": { "enum": ["__proto__", "constructor", "prototype"] } } }
}
